// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
//  ENUMS
// ═══════════════════════════════════════════════════════════════

enum TrackKind {
  exam_subject
  devotional
}

enum LessonStatus {
  draft
  in_review
  published
  retired
}

enum ContentSource {
  human
  ai_draft
  ai_variant
}

enum VerificationMethod {
  human
  cas
  both
}

enum BlockType {
  text
  formula
  image
  audio
  video
  worked_example
  interactive
  scripture
  question
}

enum Canon {
  protestant
  orthodox
  catholic
}

enum ItemType {
  mcq
  numeric
  short_text
  order_steps
}

enum ItemStatus {
  draft
  shadow
  published
  flagged
  retired
}

enum FriendshipStatus {
  pending
  accepted
  blocked
}

enum ProgressState {
  locked
  available
  in_progress
  completed
  mastered
}

enum XpReason {
  lesson_complete
  review_on_time
  duel_win
  bonus
}

// ═══════════════════════════════════════════════════════════════
//  CONTENT
// ═══════════════════════════════════════════════════════════════

model tracks {
  id           Int       @id @default(autoincrement())
  slug         String    @unique @db.VarChar(64)
  kind         TrackKind
  display_name String    @db.VarChar(160)
  subject_id   Int?
  /// true => GDPR Art.9 handling (religious belief)
  is_sensitive Boolean   @default(false)
  created_at   DateTime  @default(now())

  modules modules[]
}

model modules {
  id           BigInt @id @default(autoincrement())
  track_id     Int
  slug         String @db.VarChar(96)
  display_name String @db.VarChar(200)
  sort_order   Int    @default(0)

  track   tracks    @relation(fields: [track_id], references: [id])
  lessons lessons[]

  @@unique([track_id, slug])
}

/// The atomic completable unit. One maths objective == one day's reading.
model lessons {
  id           BigInt        @id @default(autoincrement())
  module_id    BigInt
  slug         String        @db.VarChar(96)
  display_name String        @db.VarChar(240)
  summary      String?       @db.VarChar(500)
  est_minutes  Int           @default(10) @db.TinyInt
  sort_order   Int           @default(0)
  /// Official syllabus reference (exam tracks)
  programa_ref String?       @db.VarChar(160)
  status       LessonStatus  @default(draft)
  source       ContentSource @default(human)
  verified_by  BigInt?
  verified_at  DateTime?
  created_at   DateTime      @default(now())

  module      modules                @relation(fields: [module_id], references: [id])
  blocks      blocks[]
  items       items[]
  requires    lesson_prerequisites[] @relation("lesson_requires")
  required_by lesson_prerequisites[] @relation("lesson_required_by")

  @@unique([module_id, slug])
  @@index([status])
}

model lesson_prerequisites {
  lesson_id   BigInt
  requires_id BigInt
  /// e.g. "needs limite first"
  note        String? @db.VarChar(240)

  lesson   lessons @relation("lesson_requires", fields: [lesson_id], references: [id])
  requires lessons @relation("lesson_required_by", fields: [requires_id], references: [id])

  @@id([lesson_id, requires_id])
}

model blocks {
  id         BigInt    @id @default(autoincrement())
  lesson_id  BigInt
  sort_order Int
  block_type BlockType
  /// Shape depends on block_type — validate with zod on write
  payload    Json
  /// Narration for ANY block type
  audio_url  String?   @db.VarChar(500)
  /// Required when block_type = image
  alt_text   String?   @db.VarChar(500)
  /// Copyright provenance. Required.
  source_ref String?   @db.VarChar(300)

  lesson lessons @relation(fields: [lesson_id], references: [id])

  @@index([lesson_id, sort_order])
}

// ═══════════════════════════════════════════════════════════════
//  SCRIPTURE (devotional pilot track)
// ═══════════════════════════════════════════════════════════════

model scripture_editions {
  id           Int    @id @default(autoincrement())
  code         String @unique @db.VarChar(32)
  display_name String @db.VarChar(160)
  canon        Canon
  license      String @db.VarChar(240)

  verses scripture_verses[]
}

model scripture_verses {
  edition_id Int
  /// USFM code: GEN, JHN, ...
  book       String @db.VarChar(16)
  chapter    Int    @db.SmallInt
  verse      Int    @db.SmallInt
  body       String @db.Text

  edition scripture_editions @relation(fields: [edition_id], references: [id])

  @@id([edition_id, book, chapter, verse])
}

// ═══════════════════════════════════════════════════════════════
//  ITEMS
// ═══════════════════════════════════════════════════════════════

model items {
  id             BigInt              @id @default(autoincrement())
  lesson_id      BigInt
  item_type      ItemType
  stem           String              @db.Text
  answer_key     Json
  explanation    String?             @db.Text
  difficulty     Int                 @default(3) @db.TinyInt
  status         ItemStatus          @default(draft)
  source         ContentSource       @default(human)
  verification   VerificationMethod?
  verified_by    BigInt?
  verified_at    DateTime?
  n_responses    Int                 @default(0)
  /// Proportion correct
  p_value        Decimal?            @db.Decimal(4, 3)
  /// NEGATIVE => wrong answer key. Auto-flag.
  point_biserial Decimal?            @db.Decimal(4, 3)

  lesson  lessons        @relation(fields: [lesson_id], references: [id])
  options item_options[]

  @@index([lesson_id, status])
}

model item_options {
  id         BigInt  @id @default(autoincrement())
  item_id    BigInt
  sort_order Int     @db.TinyInt
  body       String  @db.Text
  is_correct Boolean @default(false)

  item items @relation(fields: [item_id], references: [id])
}

// ═══════════════════════════════════════════════════════════════
//  USERS & AUTH
// ═══════════════════════════════════════════════════════════════

model users {
  id                  BigInt    @id @default(autoincrement())
  email               String?   @unique @db.VarChar(255)
  handle              String    @unique @db.VarChar(32)
  password_hash       String?   @db.VarChar(255)
  display_name        String?   @db.VarChar(96)
  /// Age gate: Romania's minimum is 16
  birth_year          Int?      @db.SmallInt
  parental_consent_at DateTime?
  email_verified_at   DateTime?
  specialization_id   Int?
  grade_level         Int?      @db.TinyInt
  bac_year            Int?      @db.SmallInt
  timezone            String    @default("Europe/Bucharest") @db.VarChar(48)
  referral_code       String?   @unique @db.VarChar(12)
  referred_by         BigInt?
  created_at          DateTime  @default(now())

  consents sensitive_consents[]
}

/// GDPR Art.9 consent, separately revocable and auditable.
model sensitive_consents {
  id             BigInt    @id @default(autoincrement())
  user_id        BigInt
  /// e.g. 'devotional_track'
  purpose        String    @db.VarChar(64)
  granted_at     DateTime  @default(now())
  revoked_at     DateTime?
  policy_version String    @db.VarChar(16)

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id, purpose])
}

model refresh_tokens {
  id         String    @id @default(uuid())
  user_id    BigInt
  token_hash String    @unique @db.VarChar(64)
  family_id  String
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
  @@index([family_id])
}

/// Single-use tokens for email verification and password reset.
/// Only the SHA-256 hash is stored.
model auth_tokens {
  id         String    @id @default(uuid())
  user_id    BigInt
  /// 'email_verify' | 'password_reset'
  purpose    String    @db.VarChar(32)
  token_hash String    @unique @db.VarChar(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, purpose])
}

/// NOTE: a CHECK (user_low < user_high) is added by hand after migration.
/// Prisma can't model CHECK constraints, so always sort the pair in the
/// service layer before reading or writing.
model friendships {
  user_low     BigInt
  user_high    BigInt
  requested_by BigInt
  status       FriendshipStatus @default(pending)
  created_at   DateTime         @default(now())

  @@id([user_low, user_high])
}

// ═══════════════════════════════════════════════════════════════
//  PROGRESS
// ═══════════════════════════════════════════════════════════════

model enrollments {
  user_id    BigInt
  track_id   Int
  started_at DateTime  @default(now())
  /// Exam date — drives the pace calculation
  target_date DateTime? @db.Date

  @@id([user_id, track_id])
}

model lesson_progress {
  user_id        BigInt
  lesson_id      BigInt
  state          ProgressState @default(available)
  completed_at   DateTime?
  /// Spaced repetition
  next_review_at DateTime?     @db.Date
  ease           Decimal       @default(2.50) @db.Decimal(4, 2)

  @@id([user_id, lesson_id])
  @@index([user_id, next_review_at])
}

/// Append-only answer log. Source of truth for XP and item statistics.
model responses {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  item_id    BigInt
  given      Json
  is_correct Boolean
  ms_taken   Int?
  /// LOCAL date (Europe/Bucharest), day rolls at 04:00
  local_date DateTime @db.Date
  created_at DateTime @default(now())

  @@index([user_id, local_date])
  @@index([item_id])
}

/// Append-only, always computed server-side. Never trust a client total.
model xp_events {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  amount     Int
  reason     XpReason
  lesson_id  BigInt?
  local_date DateTime @db.Date
  created_at DateTime @default(now())

  @@index([user_id, local_date])
}

model user_streaks {
  user_id            BigInt   @id
  current_len        Int      @default(0)
  longest_len        Int      @default(0)
  /// LOCAL date, day rolls at 04:00 Europe/Bucharest
  last_active_date   DateTime @db.Date
  freezes_available  Int      @default(0) @db.TinyInt
  weekly_goal_days   Int      @default(5) @db.TinyInt
}
