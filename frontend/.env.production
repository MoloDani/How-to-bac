# Used by `pnpm build`. Vite compiles this value into the bundle, so rebuild and
# redeploy after changing it. Nothing here is secret: everything a VITE_-prefixed
# variable holds ships to the browser.
#
# If this file is missing, the app calls /v1 on its own domain, and nginx answers
# with a 404 because there's no such file. Either keep this, or make the reverse
# proxy forward /v1 to the API.
VITE_API_URL=https://bac-api.moloserver.ro/v1
