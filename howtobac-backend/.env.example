NODE_ENV=development
PORT=3000
# How many proxies sit in front of the API, so rate limits see the real client
# IP: 0 when exposed directly, 1 behind Coolify's Traefik alone, 2 when
# Cloudflare's proxy is in front of it as well.
TRUST_PROXY=0

# Postgres in Docker on the database server — setup: deploy/postgres/README.md
DATABASE_URL="postgresql://howtobac:CHANGE_ME@192.168.3.103:5432/howtobac?schema=howtobac"
# Database WIPED on every `pnpm test:e2e` run
TEST_DATABASE_URL="postgresql://howtobac:CHANGE_ME@192.168.3.103:5432/howtobac_test?schema=howtobac"
# Only needed for `pnpm db:migrate` (creating new migrations)
SHADOW_DATABASE_URL="postgresql://howtobac:CHANGE_ME@192.168.3.103:5432/howtobac_shadow?schema=howtobac"

# JWT access tokens — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30

# Resend — leave RESEND_API_KEY empty in development to log email links instead of sending
RESEND_API_KEY=
MAIL_FROM="How to Bac <noreply@example.com>"

# Frontend origin, used for links in emails (/verify?token=..., /reset?token=...)
# In production: https://howtobac.ro
APP_BASE_URL=http://localhost:5173

# Comma-separated list of browser origins allowed to call this API. The app is
# served from a different origin than the API, so in production this is
# https://howtobac.ro,https://www.howtobac.ro
CORS_ORIGINS=http://localhost:5173

# Refresh-token cookie. COOKIE_SECURE=true in production (served over HTTPS).
# SameSite=lax is enough while the app and API share a registrable domain
# (howtobac.ro and api.howtobac.ro); only cross-domain setups need none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Used by `pnpm db:seed` to create or promote the first admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Telemetry — keys from https://observe.nestjs.com. Leave both empty to turn it off.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Swagger UI at /docs. Defaults to on outside production.
SWAGGER_ENABLED=
# Set both to protect /docs with a username and password (do this before enabling it in production)
SWAGGER_USER=
SWAGGER_PASSWORD=
