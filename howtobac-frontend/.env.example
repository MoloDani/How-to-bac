# Where the API lives, baked into the build.
# Leave unset in development: the Vite dev server proxies /v1 to VITE_DEV_API_TARGET.
VITE_API_URL=https://bac-api.moloserver.ro/v1

# Development only: what the dev server forwards /v1 to.
# Point it at http://127.0.0.1:3000 to work against a locally running API.
VITE_DEV_API_TARGET=https://bac-api.moloserver.ro
