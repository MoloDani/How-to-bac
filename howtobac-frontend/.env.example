# Where the API lives, baked into the build by `pnpm build`.
# Production uses the API's own domain; see .env.production.
VITE_API_URL=https://api.howtobac.ro/v1

# Development only: what the dev server forwards /v1 to.
# Point it at http://127.0.0.1:3000 to work against a locally running API.
VITE_DEV_API_TARGET=https://api.howtobac.ro
